# Default: full local scientific app, localhost:8765 (optional PySCF installed separately).
QAL_MODE=local
QAL_HOST=127.0.0.1
# PORT=8765
# Docker/Railway image sets QAL_MODE=public and QAL_HOST=0.0.0.0.
# Railway supplies PORT; do not hardcode a visitor's localhost into frontend URLs.
# QAL_COMPUTE_TIMEOUT=8
# QAL_WORKER_MEMORY_MIB=192
