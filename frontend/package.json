{
  "name": "quantum-atom-lab",
  "version": "3.0.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir dist-pages && node ../scripts/prepare_pages.mjs",
    "preview:pages": "vite preview --outDir dist-pages --host 127.0.0.1 --port 8770",
    "test:science": "node ../scripts/test_browser_science.mjs"
  },
  "dependencies": {
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.181.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
